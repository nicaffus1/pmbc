rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function approvedMember() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.status == 'approved';
    }
    function isAdmin() {
      return approvedMember()
        && get(userPath(request.auth.uid)).data.role == 'admin';
    }
    function allowedPrayerFields(data) {
      return data.keys().hasOnly([
          'text', 'subjectName', 'visibility', 'status', 'authorId', 'authorName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'text', 'subjectName', 'visibility', 'status', 'authorId', 'authorName', 'createdAt', 'updatedAt'
        ])
        && data.text is string && data.text.size() >= 3 && data.text.size() <= 2000
        && data.subjectName is string
        && data.subjectName.size() >= 2 && data.subjectName.size() <= 80
        && data.visibility in ['members', 'leadership']
        && data.status in ['active', 'answered', 'removed']
        && data.authorId is string
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 80;
    }
    function canReadPrayer(data) {
      return approvedMember()
        && (data.status != 'removed' || isAdmin())
        && (data.visibility == 'members'
          || data.authorId == request.auth.uid
          || isAdmin());
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName','email','role','status','createdAt'])
        && request.resource.data.keys().hasAll(['displayName','email','role','status','createdAt'])
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin();
      allow delete: if false;
    }

    // In-app notifications. Only administrators may publish; all approved members
    // can read member notices, while admin-only notices remain restricted.
    match /notifications/{notificationId} {
      function validNotice(data) {
        return data.keys().hasAll([
          'title','body','audience','kind','linkTab','active','createdBy','createdAt'
        ]) && data.keys().hasOnly([
          'title','body','audience','kind','linkTab','active','createdBy','createdAt'
        ])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 100
        && data.body is string && data.body.size() >= 3 && data.body.size() <= 500
        && data.audience in ['members','admins']
        && data.kind in ['general','event','prayer','serve','admin']
        && data.linkTab in ['','home','prayer','serve','more']
        && data.active is bool;
      }
      // Server-generated individual notices use audience='person' and a
      // recipientId. Client users cannot create these via Firestore.
      allow get, list: if isAdmin() ||
        (approvedMember() && resource.data.audience == 'members') ||
        (approvedMember() && resource.data.recipientId == request.auth.uid);
      allow create: if isAdmin()
        && validNotice(request.resource.data)
        && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    match /users/{userId}/pushTokens/{tokenId} {
      function validToken(data) {
        return data.keys().hasOnly(['token','enabled','platform','updatedAt'])
          && data.keys().hasAll(['token','enabled','platform','updatedAt'])
          && data.token is string && data.token.size() >= 20 && data.token.size() <= 4096
          && data.enabled == true
          && data.platform == 'web'
          && data.updatedAt == request.time
          && tokenId.matches('^[a-f0-9]{64}$');
      }
      allow get, list: if approvedMember() && request.auth.uid == userId;
      allow create, update: if approvedMember() && request.auth.uid == userId
        && validToken(request.resource.data);
      allow delete: if approvedMember() && request.auth.uid == userId;
    }

    match /users/{userId}/notificationReads/{notificationId} {
      allow get, list: if signedIn() && request.auth.uid == userId
        && approvedMember();
      allow create: if approvedMember() && request.auth.uid == userId
        && exists(/databases/$(database)/documents/notifications/$(notificationId))
        && (get(/databases/$(database)/documents/notifications/$(notificationId)).data.audience == 'members'
            || (get(/databases/$(database)/documents/notifications/$(notificationId)).data.audience == 'person'
                && get(/databases/$(database)/documents/notifications/$(notificationId)).data.recipientId == userId)
            || isAdmin())
        && request.resource.data.keys().hasOnly(['readAt'])
        && request.resource.data.keys().hasAll(['readAt'])
        && request.resource.data.readAt == request.time;
      allow update, delete: if false;
    }

    match /prayers/{prayerId} {
      allow get, list: if canReadPrayer(resource.data);

      // Approved member creates a request under their actual identity.
      allow create: if approvedMember()
        && allowedPrayerFields(request.resource.data)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName ==
          get(userPath(request.auth.uid)).data.displayName
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Original author may edit the text, audience, and answered status.
      // Administrators can moderate requests, but cannot replace the author.
      allow update: if approvedMember()
        && (resource.data.authorId == request.auth.uid || isAdmin())
        && allowedPrayerFields(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['text','subjectName','visibility','status','updatedAt'])
        && (isAdmin()
          || (resource.data.status != 'removed'
            && request.resource.data.status in ['active','answered']))
        && request.resource.data.updatedAt == request.time;

      // No accidental permanent removal of prayer history in V1.
      allow delete: if false;

      match /prayedBy/{memberId} {
        function parentPrayer() {
          return get(/databases/$(database)/documents/prayers/$(prayerId)).data;
        }
        // An ordinary member can see only their own acknowledgement, not totals.
        allow get: if approvedMember()
          && request.auth.uid == memberId && canReadPrayer(parentPrayer());
        // Only request authors and admins can read all acknowledgements and sum counts.
        allow list: if approvedMember()
          && (isAdmin() || parentPrayer().authorId == request.auth.uid)
          && canReadPrayer(parentPrayer());
        allow create: if approvedMember()
          && request.auth.uid == memberId
          && canReadPrayer(parentPrayer()) && parentPrayer().status == 'active'
          && request.resource.data.keys().hasOnly(['createdAt','count','lastPrayedAt'])
          && request.resource.data.keys().hasAll(['createdAt','count','lastPrayedAt'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.lastPrayedAt == request.time
          && request.resource.data.count == 1;
        // Subsequent prayers increment the member's personal count one at a time.
        allow update: if approvedMember()
          && request.auth.uid == memberId
          && canReadPrayer(parentPrayer()) && parentPrayer().status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['count','lastPrayedAt'])
          && request.resource.data.count is int
          && request.resource.data.count ==
            (('count' in resource.data) ? resource.data.count : 1) + 1
          && request.resource.data.lastPrayedAt == request.time
          && request.time >=
            (('lastPrayedAt' in resource.data)
              ? resource.data.lastPrayedAt
              : resource.data.createdAt) + duration.value(1, 'h');
        // No member can erase past prayer acknowledgements.
        allow delete: if false;
      }
    }

    // Church announcements: only active records are public.
    match /announcements/{announcementId} {
      function validAnnouncement(data) {
        return data.keys().hasAll(['title','description','expiresOn','active','createdBy','createdAt'])
          && data.keys().hasOnly(['title','description','expiresOn','active','createdBy','createdAt'])
          && data.title is string && data.title.size() >= 2 && data.title.size() <= 100
          && data.description is string && data.description.size() >= 3
          && data.description.size() <= 1200
          && data.expiresOn is string
          && data.expiresOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.active is bool;
      }
      allow get, list: if resource.data.active == true || isAdmin();
      allow create: if isAdmin() && validAnnouncement(request.resource.data)
        && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && validAnnouncement(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title','description','expiresOn','active']);
      allow delete: if false;
    }

    // Church events: Central Time, with an editable start/end and automatic expiry.
    match /events/{eventId} {
      function validEvent(data) {
        return data.keys().hasAll([
            'title','description','location','startsAt','endsAt',
            'timeZone','active','createdBy','createdAt'
          ])
          && data.keys().hasOnly([
            'title','description','location','startsAt','endsAt',
            'timeZone','active','createdBy','createdAt'
          ])
          && data.title is string && data.title.size() >= 2 && data.title.size() <= 100
          && data.description is string && data.description.size() <= 1200
          && data.location is string && data.location.size() <= 160
          && data.startsAt is string
          && data.startsAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$')
          && data.endsAt is string
          && data.endsAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$')
          && data.endsAt > data.startsAt
          && data.timeZone == 'America/Chicago'
          && data.active is bool;
      }
      allow get, list: if resource.data.active == true || isAdmin();
      allow create: if isAdmin() && validEvent(request.resource.data)
        && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && validEvent(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title','description','location','startsAt','endsAt','active']);
      allow delete: if false;
    }

    match /ministries/{ministryId} {
      // Only approved members can discover church ministries.
      allow get, list: if approvedMember();

      // Only an approved administrator can create a ministry.
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name','description','active','createdBy','createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'name','description','active','createdBy','createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      // Administrators can archive and restore a ministry without deleting its history.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
        && request.resource.data.active is bool;
      allow delete: if false;

      match /positions/{positionId} {
        allow get, list: if approvedMember();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly([
            'title','description','active','createdBy','createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'title','description','active','createdBy','createdAt'
          ])
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 2
          && request.resource.data.title.size() <= 80
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 500
          && request.resource.data.active == true
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/ministries/$(ministryId))
          && get(/databases/$(database)/documents/ministries/$(ministryId)).data.active == true;
        // Admins may edit position title or description, or archive/restore.
        allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title','description','active'])
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 2
          && request.resource.data.title.size() <= 80
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 500
          && request.resource.data.active is bool;
        allow delete: if false;

        match /recurring/{scheduleId} {
          allow get, list: if approvedMember();
          allow create: if isAdmin()
            && exists(/databases/$(database)/documents/ministries/$(ministryId))
            && get(/databases/$(database)/documents/ministries/$(ministryId)).data.active == true
            && exists(/databases/$(database)/documents/ministries/$(ministryId)/positions/$(positionId))
            && get(/databases/$(database)/documents/ministries/$(ministryId)/positions/$(positionId)).data.active == true
            && request.resource.data.keys().hasOnly(['title','weekday','startTime','endTime','notes','rosterVisibility','active','createdBy','createdAt'])
            && request.resource.data.keys().hasAll(['title','weekday','startTime','endTime','notes','rosterVisibility','active','createdBy','createdAt'])
            && request.resource.data.title is string
            && request.resource.data.title.size() >= 2
            && request.resource.data.title.size() <= 80
            && request.resource.data.weekday is int
            && request.resource.data.weekday >= 0
            && request.resource.data.weekday <= 6
            && request.resource.data.startTime is string
            && request.resource.data.startTime.matches('^[0-9]{2}:[0-9]{2}$')
            && request.resource.data.endTime is string
            && request.resource.data.endTime.matches('^[0-9]{2}:[0-9]{2}$')
            && request.resource.data.endTime > request.resource.data.startTime
            && request.resource.data.notes is string
            && request.resource.data.notes.size() <= 300
            && request.resource.data.rosterVisibility in ['members','admins']
            && request.resource.data.active == true
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt == request.time;
          allow update: if isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
            && request.resource.data.active is bool;
          allow delete: if false;

          match /dates/{date}/members/{memberId} {
            allow get: if approvedMember()
              && (request.auth.uid == memberId || isAdmin()
                  || get(/databases/$(database)/documents/ministries/$(ministryId)/positions/$(positionId)/recurring/$(scheduleId)).data.rosterVisibility == 'members');
            allow list: if approvedMember()
              && (isAdmin()
                || get(/databases/$(database)/documents/ministries/$(ministryId)/positions/$(positionId)/recurring/$(scheduleId)).data.rosterVisibility == 'members');
            allow create: if approvedMember()
              && request.auth.uid == memberId
              && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
              && exists(/databases/$(database)/documents/ministries/$(ministryId))
              && get(/databases/$(database)/documents/ministries/$(ministryId)).data.active == true
              && exists(/databases/$(database)/documents/ministries/$(ministryId)/positions/$(positionId))
              && get(/databases/$(database)/documents/ministries/$(ministryId)/positions/$(positionId)).data.active == true
              && exists(/databases/$(database)/documents/ministries/$(ministryId)/positions/$(positionId)/recurring/$(scheduleId))
              && get(/databases/$(database)/documents/ministries/$(ministryId)/positions/$(positionId)/recurring/$(scheduleId)).data.active == true
              && request.resource.data.keys().hasOnly(['memberId','memberName','occurrenceDate','createdAt'])
              && request.resource.data.keys().hasAll(['memberId','memberName','occurrenceDate','createdAt'])
              && request.resource.data.memberId == request.auth.uid
              && request.resource.data.memberName == get(userPath(request.auth.uid)).data.displayName
              && request.resource.data.occurrenceDate == date
              && request.resource.data.createdAt == request.time;
            allow delete: if approvedMember() && request.auth.uid == memberId;
            allow update: if false;
          }
        }

        match /shifts/{shiftId} {
          allow get, list: if approvedMember();

          allow create: if isAdmin()
            && exists(/databases/$(database)/documents/ministries/$(ministryId))
            && get(/databases/$(database)/documents/ministries/$(ministryId)).data.active == true
            && exists(/databases/$(database)/documents/ministries/$(ministryId)/positions/$(positionId))
            && get(/databases/$(database)/documents/ministries/$(ministryId)/positions/$(positionId)).data.active == true
            && request.resource.data.keys().hasOnly([
              'startsAt','endsAt','timeZone','notes','active','createdBy','createdAt','rosterVisibility'
            ])
            && request.resource.data.keys().hasAll([
              'startsAt','endsAt','timeZone','notes','active','createdBy','createdAt','rosterVisibility'
            ])
            && request.resource.data.startsAt is string
            && request.resource.data.startsAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$')
            && request.resource.data.endsAt is string
            && request.resource.data.endsAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$')
            && request.resource.data.endsAt > request.resource.data.startsAt
            && request.resource.data.timeZone == 'America/Chicago'
            && request.resource.data.rosterVisibility in ['members', 'admins']
            && request.resource.data.notes is string
            && request.resource.data.notes.size() <= 300
            && request.resource.data.active == true
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt == request.time;
          // Admins may edit shift date/time/notes, roster visibility, or archive it.
          // Immutable creation data and nested volunteer sign-ups stay unchanged.
          allow update: if isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['startsAt','endsAt','notes','rosterVisibility','active'])
            && request.resource.data.active is bool
            && request.resource.data.notes is string
            && request.resource.data.notes.size() <= 300
            && request.resource.data.startsAt is string
            && request.resource.data.startsAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$')
            && request.resource.data.endsAt is string
            && request.resource.data.endsAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$')
            && request.resource.data.endsAt > request.resource.data.startsAt
            && (!('rosterVisibility' in request.resource.data)
                || request.resource.data.rosterVisibility in ['members','admins']);
          allow delete: if false;

          match /signups/{memberId} {
            allow get: if approvedMember()
              && (request.auth.uid == memberId || isAdmin());
            // Existing shifts without this field default to member-visible.
            // A whole-roster query is permitted only for the configured audience.
            allow list: if approvedMember()
              && (isAdmin()
                || !('rosterVisibility' in get(/databases/$(database)/documents/ministries/$(ministryId)/positions/$(positionId)/shifts/$(shiftId)).data)
                || get(/databases/$(database)/documents/ministries/$(ministryId)/positions/$(positionId)/shifts/$(shiftId)).data.rosterVisibility == 'members');
            allow create: if approvedMember()
              && request.auth.uid == memberId
              && exists(/databases/$(database)/documents/ministries/$(ministryId))
              && get(/databases/$(database)/documents/ministries/$(ministryId)).data.active == true
              && exists(/databases/$(database)/documents/ministries/$(ministryId)/positions/$(positionId))
              && get(/databases/$(database)/documents/ministries/$(ministryId)/positions/$(positionId)).data.active == true
              && exists(/databases/$(database)/documents/ministries/$(ministryId)/positions/$(positionId)/shifts/$(shiftId))
              && get(/databases/$(database)/documents/ministries/$(ministryId)/positions/$(positionId)/shifts/$(shiftId)).data.active == true
              && request.resource.data.keys().hasOnly(['memberId','memberName','createdAt'])
              && request.resource.data.keys().hasAll(['memberId','memberName','createdAt'])
              && request.resource.data.memberId == request.auth.uid
              && request.resource.data.memberName == get(userPath(request.auth.uid)).data.displayName
              && request.resource.data.createdAt == request.time;
            allow delete: if approvedMember() && request.auth.uid == memberId;
            allow update: if false;
          }
        }

        match /signups/{memberId} {
          // A volunteer can view only their own signup; admins may review all.
          allow get: if approvedMember()
            && (request.auth.uid == memberId || isAdmin());
          allow list: if isAdmin();
          allow create: if approvedMember()
            && request.auth.uid == memberId
            && exists(/databases/$(database)/documents/ministries/$(ministryId))
            && get(/databases/$(database)/documents/ministries/$(ministryId)).data.active == true
            && exists(/databases/$(database)/documents/ministries/$(ministryId)/positions/$(positionId))
            && get(/databases/$(database)/documents/ministries/$(ministryId)/positions/$(positionId)).data.active == true
            && request.resource.data.keys().hasOnly(['memberId','memberName','createdAt'])
            && request.resource.data.keys().hasAll(['memberId','memberName','createdAt'])
            && request.resource.data.memberId == request.auth.uid
            && request.resource.data.memberName == get(userPath(request.auth.uid)).data.displayName
            && request.resource.data.createdAt == request.time;
          allow delete: if approvedMember() && request.auth.uid == memberId;
          allow update: if false;
        }
      }
    }

    // Public sermon index. Admin-only edits to trusted sermon metadata.
    match /sermons/{sermonId} {
      function validSermon(data) {
        return sermonId.matches('^[A-Za-z0-9_-]{11}
    match /{document=**} { allow read, write: if false; }
  }
}
)
          && data.keys().hasOnly(['id','title','speaker','scripture','series','topics','description','published','updatedAt'])
          && data.keys().hasAll(['id','title','speaker','scripture','series','topics','description','published','updatedAt'])
          && data.id == sermonId
          && data.title is string && data.title.size() >= 1 && data.title.size() <= 180
          && data.speaker is string && data.speaker.size() <= 100
          && data.scripture is string && data.scripture.size() <= 120
          && data.series is string && data.series.size() <= 100
          && data.description is string && data.description.size() <= 1200
          && data.published is string && data.published.size() <= 50
          && data.topics is list && data.topics.size() <= 12
          && data.updatedAt == request.time;
      }
      allow get, list: if true;
      allow create, update: if isAdmin() && validSermon(request.resource.data);
      allow delete: if false;
    }

    // No access to other collections until they have dedicated rules.
    match /{document=**} { allow read, write: if false; }
  }
}
