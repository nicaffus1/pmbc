rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function approvedMember() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.status == 'approved';
    }
    function isAdmin() {
      return approvedMember()
        && get(userPath(request.auth.uid)).data.role == 'admin';
    }
    function allowedPrayerFields(data) {
      return data.keys().hasOnly([
          'text', 'visibility', 'status', 'authorId', 'authorName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'text', 'visibility', 'status', 'authorId', 'authorName', 'createdAt', 'updatedAt'
        ])
        && data.text is string && data.text.size() >= 3 && data.text.size() <= 2000
        && data.visibility in ['members', 'leadership']
        && data.status in ['active', 'answered']
        && data.authorId is string
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 80;
    }
    function canReadPrayer(data) {
      return approvedMember()
        && (data.visibility == 'members'
          || data.authorId == request.auth.uid
          || isAdmin());
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName','email','role','status','createdAt'])
        && request.resource.data.keys().hasAll(['displayName','email','role','status','createdAt'])
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin();
      allow delete: if false;
    }

    match /prayers/{prayerId} {
      allow get, list: if canReadPrayer(resource.data);

      // Approved member creates a request under their actual identity.
      allow create: if approvedMember()
        && allowedPrayerFields(request.resource.data)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName ==
          get(userPath(request.auth.uid)).data.displayName
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Original author may edit the text, audience, and answered status.
      // Administrators can moderate requests, but cannot replace the author.
      allow update: if approvedMember()
        && (resource.data.authorId == request.auth.uid || isAdmin())
        && allowedPrayerFields(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['text','visibility','status','updatedAt'])
        && request.resource.data.updatedAt == request.time;

      // No accidental permanent removal of prayer history in V1.
      allow delete: if false;

      match /prayedBy/{memberId} {
        // Members see only their own 'I Prayed' state, never a list of voters.
        allow get: if approvedMember()
          && request.auth.uid == memberId
          && canReadPrayer(
            get(/databases/$(database)/documents/prayers/$(prayerId)).data
          );
        allow list: if false;

        allow create: if approvedMember()
          && request.auth.uid == memberId
          && canReadPrayer(
            get(/databases/$(database)/documents/prayers/$(prayerId)).data
          )
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.keys().hasAll(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow delete: if approvedMember()
          && request.auth.uid == memberId
          && canReadPrayer(
            get(/databases/$(database)/documents/prayers/$(prayerId)).data
          );
        allow update: if false;
      }
    }

    match /ministries/{ministryId} {
      // Only approved members can discover church ministries.
      allow get, list: if approvedMember();

      // Only an approved administrator can create a ministry.
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name','description','active','createdBy','createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'name','description','active','createdBy','createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      // Ministry editing and delegated leader roles are later steps.
      allow update, delete: if false;

      match /positions/{positionId} {
        allow get, list: if approvedMember();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly([
            'title','description','active','createdBy','createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'title','description','active','createdBy','createdAt'
          ])
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 2
          && request.resource.data.title.size() <= 80
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 500
          && request.resource.data.active == true
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/ministries/$(ministryId))
          && get(/databases/$(database)/documents/ministries/$(ministryId)).data.active == true;
        allow update, delete: if false;

        match /signups/{memberId} {
          // A volunteer can view only their own signup; admins may review all.
          allow get: if approvedMember()
            && (request.auth.uid == memberId || isAdmin());
          allow list: if isAdmin();
          allow create: if approvedMember()
            && request.auth.uid == memberId
            && exists(/databases/$(database)/documents/ministries/$(ministryId))
            && get(/databases/$(database)/documents/ministries/$(ministryId)).data.active == true
            && exists(/databases/$(database)/documents/ministries/$(ministryId)/positions/$(positionId))
            && get(/databases/$(database)/documents/ministries/$(ministryId)/positions/$(positionId)).data.active == true
            && request.resource.data.keys().hasOnly(['memberId','memberName','createdAt'])
            && request.resource.data.keys().hasAll(['memberId','memberName','createdAt'])
            && request.resource.data.memberId == request.auth.uid
            && request.resource.data.memberName == get(userPath(request.auth.uid)).data.displayName
            && request.resource.data.createdAt == request.time;
          allow delete: if approvedMember() && request.auth.uid == memberId;
          allow update: if false;
        }
      }
    }

    // No access to other collections until they have dedicated rules.
    match /{document=**} { allow read, write: if false; }
  }
}
