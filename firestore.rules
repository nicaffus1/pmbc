rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }
    function approvedMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    match /users/{userId} {
      // Approved administrators may read all accounts to review pending registrations.
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      // A new user can ONLY create their own pending member record.
      // They cannot grant themselves approval or an administrator/leader role.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName','email','role','status','createdAt'])
        && request.resource.data.keys().hasAll(['displayName','email','role','status','createdAt'])
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.createdAt == request.time;

      // Approval, roles and profile changes require an approved administrator.
      allow update: if isAdmin();
      allow delete: if false;
    }
    // Everything else stays inaccessible until its feature-specific
    // security rules have been designed, reviewed and tested.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
